# ChangeGuard AI — Safe Environment Variable Reference (.env.example)
#
# IMPORTANT:
# - ChangeGuard AI reads PROCESS ENVIRONMENT VARIABLES directly via
#   OrchestratorConfig.from_env() and project/agents/munshif_testing/groq_model.py.
# - Local .env files are NOT automatically loaded by the application.
# - NEVER commit a real .env file or real API credentials to Git.
# - On Windows PowerShell, set variables in your shell session before starting uvicorn:
#     $env:GROQ_API_KEY = "<your-groq-api-key>"
#     $env:GROQ_MODEL = "<your-configured-groq-model>"
#     .\.venv\Scripts\python.exe -m uvicorn project.main:app --host 127.0.0.1 --port 8000

# --- Live Groq LLM Configuration (required ONLY for execution_mode="live_llm") ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_configured_groq_model_here

# --- Optional M02 Orchestrator & Backend Settings ---
# CHANGEGUARD_ENV=development
# CHANGEGUARD_APP_HOST=127.0.0.1
# CHANGEGUARD_APP_PORT=8000
# CHANGEGUARD_DB_PATH=.changeguard/changeguard.sqlite3
# CHANGEGUARD_WORKSPACE_ROOT=.changeguard/workspaces
# CHANGEGUARD_EXECUTION_MODE=offline_test
# CHANGEGUARD_ALLOWED_REPO_ROOTS=C:\path\to\allowed\repos
# CHANGEGUARD_TRUSTED_EXECUTION_ROOTS=C:\path\to\trusted\fixtures
# CHANGEGUARD_CONFIGURED_REPOSITORIES=mini-pos-demo=C:\path\to\trusted\fixtures\pos_repo
# CHANGEGUARD_VERIFICATION_TIMEOUT=60
# CHANGEGUARD_GIT_TIMEOUT=30
# CHANGEGUARD_MAX_CONCURRENT_RUNS=4
# CHANGEGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
